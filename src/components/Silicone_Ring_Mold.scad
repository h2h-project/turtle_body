/*
 Hope Turtle — silicone ring mold. Units: mm. License: CERN-OHL-S-2.0.

 ONE two-part pressed mold that casts, in a single session:
  * ring_count FLAT insert-seal rings (Ø75/Ø85 × 1.5, for the cap insert
    grooves);
  * ONE round AXLE O-RING, nested in the centre of the first flat mold.
    O-ring ID is tied to the sealing (round) section of the hex-shaft axle.

 The bottom plate has the flat-ring channels + the lower O-ring half-torus
 + 3 male alignment pegs. The top plate has the upper O-ring half-torus +
 3 female holes + the O-ring fill/vent. Press together (pegs seat in holes),
 fill, cure, split, peel.

 Print mold_bottom and mold_top flat (channels up). part=mold is an exploded
 inspection view, not a print. Nominal dims; no shrinkage. Seals NOT
 validated (CLAUDE.md s8).

 SOURCE FILE — geometry lives in lib/silicone_ring_mold.scad + lib/params.scad.
 The committed self-contained file is generated by build/build.py.
*/

/* [Output] */
part = "mold"; // [mold,mold_bottom,mold_top,rings,oring]
ring_count = 2;
curve_segments = 240; // [120:24:480]

/* [Mold body] */
mold_floor_thickness = 3;
mold_spacing = 8; // gap between flat mold bodies

use <../../lib/silicone_ring_mold.scad>

silicone_ring_molds(part = part, ring_count = ring_count,
                    floor_t = mold_floor_thickness,
                    spacing = mold_spacing,
                    fn = curve_segments);
