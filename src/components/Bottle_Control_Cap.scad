/*
 Hope Turtle — control cap for the current full-turtle sine cage. Units: mm.
 License: CERN-OHL-S-2.0.
 Cap disk 102 mm (was 100); matching cage cavity 104 mm (1 mm radial clearance).
 Print bearing face down at Z=0, open insert + boss facing up.
 5 mm roof + 2 mm internal boss (TB-03).
 The axle bore carries an O-ring gland (rotary seal on the spinning axle
 round section) -- waterproofs the bore. O-ring is cast in Silicone_Ring_Mold.
 Side tabs (two internal cavity ribs + lip extension, on by default) are a
 fit/registration experiment -- not validated. See lib/control_cap.scad.
 Each tab carries a 5 mm wire-routing channel down to the cavity, for
 button wiring.

 Tabs slide sideways together (tab_side_offset, same real-world direction,
 not mirrored, no rotation about the cap axis) rather than rotating as in
 earlier revisions; the flat inner face is measured INWARD from the
 insert's TRUE outer wall (tab_wall_inset), not from the cavity wall. The
 cap can show a faint reference etch line across the cavity ceiling along
 the button axis. The button holes can slide off that same etched line
 (button_axis_offset), mirroring the tab slide. Merged in from the
 experimental Bottle_Control_Cap-vX.scad fork (2026-10-13) -- see that
 file's revision history for how these pieces were developed; the taper,
 floor-edge fillets, wire channel and insert-wrap O-ring grooves are kept
 as production had them.

 Disk diameter 102 mm (was 100, +2 mm -- the cage's matching cavity tracks
 it automatically via p_cage_inner_d()/p_cage_bearing_pcd() in params.scad,
 so re-check the cage bundle if it was built against the old diameter).
 One insert-wrap seal groove (was two): starts flush at the insert
 shoulder, where it meets the underside of the disk, and runs 10 mm down.

 USB-C port hole: a single round through-hole on the same circle as the
 two button holes, automatically centred on the SHORT arc between them
 (the axis perpendicular to button_axis, same side as button_axis_offset)
 -- see lib/control_cap.scad's cap_usbc_hole_cut().

 SOURCE FILE — geometry lives in lib/control_cap.scad + lib/params.scad.
 The committed self-contained file is generated by build/build.py.
*/

/* [Cap body] */
top_disk_thickness  = 5;   // roof / disk thickness
centre_boss_depth   = 1.5; // extra projection of the boss into the hollow cap (was 2; lowered 0.5 mm)
centre_boss_diameter = 18;
cup_wall_thickness  = 4;
insert_total_h      = 35;
entry_chamfer_h     = 1;
entry_chamfer_delta = 1;

/* [Axle and buttons] */
shaft_hole_d   = 6;    // loose, 0.5 mm radial clearance to the Ø5 steel shaft (was 8.7 for Ø8)
button_upper_d = 16.5;
button_axis    = "y"; // [x,y]
button_center_r = 23.2; // TRUE distance, cap centre -> each button centre (was 24, ~20.9 before);
                        // the USB-C hole sits on this same circle. Keep the cage's
                        // button_r equal to it (Bottle_Control_Cage.scad)
button_axis_offset = 6; // slides BOTH button centres off the etched axle line, same
                         // real-world direction as tab_side_offset below (not mirrored)
// on-axis component of the button position, derived so the true radius stays
// button_center_r whatever the offset (23.2 / 6 -> 22.41; holes 44.8 mm apart)
hole_spacing_cc = sqrt(button_center_r * button_center_r - button_axis_offset * button_axis_offset);

/* [Axle O-ring gland] */
oring_gland_enable = true;
oring_gland_od = 8.5;       // groove bottom diameter in the bore (p_cap_oring_gland_od(): Ø9 O-ring - 0.25 squeeze; was 11.5)
oring_gland_width = 2.6;    // groove axial width
oring_gland_from_face = 3.5; // groove centre, below the cap outer face

/* [Silicone band channels] */
// One groove (was two): moved up flush with the insert shoulder -- where
// the insert meets the underside of the disk -- and extended to run 10 mm
// down from there (centre = half the height, so the groove spans
// [0, band_channel_w] from the shoulder).
band_channels_enable = true;
band_count = 1;
band_center_z_local = 5;   // groove centre, from the insert shoulder (half of band_channel_w,
                            // so the groove spans shoulder .. shoulder + band_channel_w)
band_channel_w = 10;       // groove axial height -- 1 cm, starting flush at the shoulder
band_channel_depth = 2;    // groove radial depth

/* [Side tabs] */
// Two internal ribs on the hollow insert cavity's inner wall, on the button
// axis, running the full cavity height then continuing past the top lip as
// a free post with a gradual inward taper near the tip. Not validated -- a
// fit/registration experiment; see lib/control_cap.scad.
side_tabs_enable = true;
tab_width  = 22;   // tangential width
tab_wall_inset = 6;  // tab's flat inner face, measured INWARD from the insert's TRUE
                      // outer wall (not from the cavity wall) -- 6 reproduces the old
                      // tab_depth=2-from-the-cavity-wall rib depth at the current wall
                      // thickness; see lib/control_cap.scad's cap_side_tabs()
tab_top_overhang = 28;  // how far the tabs continue past the top lip
tab_corner_fillet = 4;  // rounds the two bottom edges where the tab meets the floor
tab_tip_taper_gain = 6; // total inward (radial) lean of the inner face by the free tip
tab_taper_start = 10;   // taper begins this far below the lip
tab_side_offset = 6;    // both tabs slide this far sideways, same real-world direction
                        // (not mirrored) and same direction as button_axis_offset above --
                        // no rotation about the cap axis (was tab_rotate = -12 deg)

/* [USB-C port] */
// Single round through-hole on the same circle as the two button holes,
// centred on the SHORT arc between them (perpendicular to button_axis,
// same side as button_axis_offset above) -- so it sits clear of the side
// tabs, which run along button_axis.
usbc_hole_enable   = true;
usbc_hole_diameter = 11;

/* [Reference etch line] */
// Faint reference groove on the cavity ceiling (roof underside, the "inner"
// face you see looking up into the hollow insert), marking the diameter
// axis that runs through the centre bore and both button centres -- i.e.
// along button_axis. Purely a visual/assembly alignment mark: shallow and
// narrow, no structural role.
etch_line_enable = true;
etch_line_width  = 0.6;
etch_line_depth  = 0.2;

/* [Tab wire hole] */
// A channel drilled down each tab from its exposed free tip, angled
// so it breaks through into the hollow cavity for routing button wires.
tab_wire_hole_enable = true;
tab_wire_hole_diameter = 5;
tab_wire_hole_exit_from_lip = 15;  // how far below the lip the channel opens into the cavity

/* [Render] */
fn = 120; // [48:8:240]

use <../../lib/control_cap.scad>

color([0.74, 0.77, 0.79])
control_cap(roof_t        = top_disk_thickness,
            boss_d        = centre_boss_diameter,
            boss_depth    = centre_boss_depth,
            insert_len    = insert_total_h,
            insert_wall_t = cup_wall_thickness,
            chamfer_h     = entry_chamfer_h,
            chamfer_delta = entry_chamfer_delta,
            axle_bore_d   = shaft_hole_d,
            button_d      = button_upper_d,
            button_axis   = button_axis,
            button_radius = hole_spacing_cc,
            button_offset = button_axis_offset,
            band_enable   = band_channels_enable,
            band_count    = band_count,
            band_z1       = band_center_z_local,
            band_w        = band_channel_w,
            band_depth    = band_channel_depth,
            oring_gland    = oring_gland_enable,
            oring_gland_od = oring_gland_od,
            oring_gland_w  = oring_gland_width,
            oring_gland_z  = oring_gland_from_face,
            side_tabs      = side_tabs_enable,
            tab_width_p    = tab_width,
            tab_wall_inset_p = tab_wall_inset,
            tab_overhang_p = tab_top_overhang,
            tab_fillet_p   = tab_corner_fillet,
            tab_taper_gain_p = tab_tip_taper_gain,
            tab_taper_start_p = tab_taper_start,
            tab_side_offset_p = tab_side_offset,
            tab_wire_hole    = tab_wire_hole_enable,
            tab_wire_hole_d  = tab_wire_hole_diameter,
            tab_wire_hole_exit_from_lip = tab_wire_hole_exit_from_lip,
            etch_line       = etch_line_enable,
            etch_line_w     = etch_line_width,
            etch_line_d     = etch_line_depth,
            usbc_hole       = usbc_hole_enable,
            usbc_hole_d     = usbc_hole_diameter,
            fn            = fn);
