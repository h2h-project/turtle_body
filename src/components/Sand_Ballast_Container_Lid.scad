/*
 Hope Turtle sand ballast container -- lid (snap-on lid). Units: mm. License: CERN-OHL-S-2.0.
 EXPERIMENTAL -- not built, filled or tested.
 A 3D-printed U-shaped box that slides into the gap between the bottom
 bottle's base and the ballast's orange bottom board, its two arms either
 side of the yellow ballast fin. Fill the tray with sand, click the lid on,
 slide it under the bottle. Walls 0.4 mm (one extrusion line).
 Print plate down, skirt up (part="print", the default) -- no support.
 The matching tray is Sand_Ballast_Container_Bottom.scad.

 SOURCE FILE — geometry lives in lib/sand_ballast.scad + lib/params.scad.
 The committed self-contained file is generated by build/build.py.
*/

/* [Display] */
part = "print"; // [print,closed]  -- print = this piece alone in its print pose; closed = tray + lid together

use <../../lib/sand_ballast.scad>

sand_ballast_echo();

if (part == "print") {
    sand_ballast_lid_print();
} else if (part == "closed") {
    sand_ballast_closed();
} else {
    assert(false, str("Unknown part: ", part));
}
