/*
 Hope Turtle head fin (front fin, v6.3.1 profile). Units: mm. License: CERN-OHL-S-2.0.
 EXPERIMENTAL -- not built, fitted or tested.
 Three wooden pieces: one blue raked fin and two purple bottle-holder
 slats (above and below the front bottle). The slats bolt to the front-port
 Little John M5 pairs like the rear-fin shafts; the fin half-laps into their
 outer ends and abuts the bottle base. Slot openings 12.2 mm (0.2 mm TOTAL,
 centred). Bottle is F5 reference only, excluded from F6/STL.

 SOURCE FILE — geometry lives in lib/head_fin.scad + lib/params.scad.
 The committed self-contained file is generated by build/build.py.
*/

/* [Fit and tuning] */
half_lap_clearance = 0.2; // TOTAL extra slot width, centred on the board
exploded = 0;

/* [Display] */
part = "assembly"; // [assembly,fin,slat]
show_bottle_mockup = true;  // F5 reference only, excluded from F6/STL
enable_color_coding = true; // wooden parts; false = neutral shades of brown

/* [Render] */
fn = 96;

use <../../lib/head_fin.scad>
use <../../lib/params.scad>

module _bottle_reference() {
    // the front bottle, base at the fin's rear edge (X = 0), axis on X
    color([0.3, 0.85, 0.95, 0.35])
        rotate([0, -90, 0]) cylinder(d = p_bottle_d(), h = p_bottle_h(), $fn = 64);
}

if (part == "assembly") {
    head_fin_assembly(half_lap = half_lap_clearance, exploded = exploded,
                      fn = fn, colored = enable_color_coding);
    if (show_bottle_mockup && exploded == 0) %_bottle_reference();
} else if (part == "fin") {
    head_fin(half_lap = half_lap_clearance, fn = fn, colored = enable_color_coding);
} else if (part == "slat") {
    head_slat(half_lap = half_lap_clearance, colored = enable_color_coding);
} else {
    assert(false, str("Unknown part: ", part));
}
