/*
 Hope Turtle pressor -- Ecojoiner bottle clamp block. Units: mm. License: CERN-OHL-S-2.0.
 EXPERIMENTAL -- not built, fitted or tested. Not yet used by the Ecojoiner
 or full-turtle assemblies (they still show acorn nuts).
 A 12 mm board block in the port gap between a Little John and the bottle,
 its inner edge cut concave to the bottle radius. The John's two M5 cap
 screws drive into two 5.3 mm holes in its back edge and push it onto the
 bottle as they are turned in (screws not modelled). Two are used per port; this file always
 outputs ONE (default part="pressor", already in the print pose). Print part="pressor"
 flat on its board face; the edge holes are horizontal bores. Two per port, one each side of the bottle (24 for six ports).

 SOURCE FILE — geometry lives in lib/pressor.scad + lib/params.scad.
 The committed self-contained file is generated by build/build.py.
*/

/* [Display] */
part = "pressor"; // [pressor,assembly,profile]  -- every part is ONE piece
show_references = true;     // translucent bottle + Little John stand-ins (F5 only)
enable_color_coding = true; // false = neutral shades of brown

/* [Render] */
fn = 128;

use <../../lib/pressor.scad>

pressor_echo();

if (part == "assembly") {
    // one pressor in its port, pressed onto the bottle (references are F5 only)
    pressor_port_assembly(fn = fn, colored = enable_color_coding,
                          show_references = show_references);
} else if (part == "pressor") {
    // one piece, lying flat on its board face -- the print / STL pose
    pressor(fn = fn, colored = enable_color_coding);
} else if (part == "profile") {
    // 2D cutting outline (export as DXF/SVG); holes are drilled into the edge
    pressor_2d(fn = fn);
} else {
    assert(false, str("Unknown part: ", part));
}
